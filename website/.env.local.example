# Website (Next.js) example environment variables
# MongoDB connection used by server-side routes
NEXT_MONGODB_URI=
NEXT_MONGODB_DB=bgremover

# Public URL the frontend uses to call the worker API (must be reachable from browser)
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8000

# Shared secret token used when the website calls the worker's internal endpoints
WORKER_INTERNAL_TOKEN=replace-with-same-token-used-by-worker

# Admin token for manual cleanup route (protect this in production)
ADMIN_CLEANUP_TOKEN=replace-with-secure-admin-token

# Optional: override hourly upload limit behavior or other feature flags
# e.g., NEXT_PUBLIC_FEATURE_X=true

# NODE_ENV is usually set by your deploy/runtime
# NODE_ENV=development

# Worker example environment variables
# MongoDB connection used by worker to read/write job documents
NEXT_MONGODB_URI=
NEXT_MONGODB_DB=bgremover
# Secret token for internal requests from website -> worker
WORKER_INTERNAL_TOKEN=replace-with-a-secure-token

# Upload / job handling limits (defaults used in code shown in comments)
WORKER_MAX_UPLOAD_SIZE_BYTES=20485760  # 20 MB
WORKER_MAX_CONCURRENCY=2
WORKER_MAX_JOBS_PER_CLIENT=2

# How long to retain completed/failed jobs (hours)
WORKER_JOB_RETENTION_HOURS=24

# Cleanup interval (seconds) the worker uses to sweep old jobs
WORKER_CLEANUP_INTERVAL_SECONDS=1800

# CORS origins allowed by the worker (comma-separated)
WORKER_CORS_ORIGINS=http://localhost:3000

# Logging level (optional)
LOG_LEVEL=INFO

# Public URL the frontend uses to call the worker API (must be reachable from browser)
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8000

# Admin token for manual cleanup route (protect this in production)
ADMIN_CLEANUP_TOKEN=replace-with-secure-admin-token

# Hugging Face API token for worker to access models (if needed)
HF_TOKEN=